# Copy to server/.env and fill in. server/.env is gitignored — never commit it.
BOLNA_API_KEY=replace-with-your-bn-key
BOLNA_AGENT_ID=replace-with-your-agent-id
# Shared secret the app sends as X-Dev-Token. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Put the same value in poc_config.json (DEV_SESSION_TOKEN).
DEV_SESSION_TOKEN=replace-with-random-token
# Loopback only by default; the phone reaches it through `adb reverse tcp:8787 tcp:8787`.
HOST=127.0.0.1
PORT=8787
